<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="001" author="rolan">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users"/>
            </not>
        </preConditions>
        <createTable tableName="users">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="chat_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="user_targets">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="INTEGER">
                <constraints nullable="false" foreignKeyName="fk_targets_user" references="users(id)"/>
            </column>
            <column name="protein" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="fat" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="carbohydrates" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="fiber" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="meal_entries">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="INTEGER">
                <constraints nullable="false" foreignKeyName="fk_meal_user" references="users(id)"/>
            </column>
            <column name="protein" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="fat" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="carbohydrates" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="fiber" type="REAL">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="name_of_meal" type="TEXT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>